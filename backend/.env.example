# Copy to .env and fill in. Never commit real keys.

# Which provider drives the assistant and the admin copilot:
#   openai    -> GPT via the OpenAI Responses API (standard tier). The default:
#                gpt-5.6-luna matches Claude on this workload at a lower price.
#   anthropic -> Claude via the Anthropic SDK
USE_MODEL=openai

# Only the selected provider's key is required.
ANTHROPIC_API_KEY=
# e.g. claude-sonnet-5 (default) or claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
# e.g. gpt-5.6-luna (default, fast/cheap) or gpt-5.6-sol (flagship)
OPENAI_MODEL=gpt-5.6-luna

PORT=8000
