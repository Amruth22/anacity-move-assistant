[Unit]
Description=ANACITY Move Assistant (FastAPI + built frontend)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/anacity/backend
# --workers 1 is required: chat sessions live in process memory
ExecStart=/home/ec2-user/anacity/backend/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
